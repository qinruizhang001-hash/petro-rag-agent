{
  "name": "ccus-ops-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CCUS 全链运维控制台 — 第 1 周骨架（左栏告警卡 / 指标卡接真实 /api/ops/alarms）",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test scripts/test-quality.mjs scripts/test-text.mjs scripts/test-citations.mjs scripts/test-copy.mjs scripts/test-labels.mjs scripts/test-render.mjs",
    "licenses": "node scripts/audit-licenses.mjs",
    "licenses:self-test": "node scripts/audit-licenses.mjs --self-test",
    "perf": "node scripts/measure-fps.mjs",
    "shot": "node scripts/cdp-shot.mjs",
    "cdp-eval": "node scripts/cdp-eval.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
