# 依赖与构建产物不进仓库。
# 前端这一层的"输入"只有 package.json + package-lock.json + src/，
# node_modules 是 200 MB 级的可再生副本。
node_modules/
dist/
.vite/

# 本地环境变量（VITE_OPS_SOURCE=live 之类只对本机有意义）
.env
.env.local
.env.*.local

# TypeScript 增量构建信息
*.tsbuildinfo

# vite 在 --watch / preview 时会往配置旁边丢一份带时间戳的临时配置副本。
# 它只活几秒，但 `git add -A` 正好会撞上 —— 于是仓库里多一个 3 KB 的
# 随机文件名，且下次有人 `git add -A` 又会多一个。
vite.config.ts.timestamp-*.mjs
