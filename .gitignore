# ============================================
# Corpus PDFs (inputs, not code)
# ============================================
# 为什么连 PDF 一起排除：这批 arXiv 论文单个 1~15 MB，18 篇就 125 MB，
# 原有 5 篇 70 MB。Git 不是文件柜 —— 把几十兆二进制塞进仓库会让每次 clone
# 都变慢，而且这些论文有各自的版权与 DOI，仓库只该放**流水线**，不放语料。
#
# 语料怎么来：`python fetch_ccus_papers.py` 自动下载（见 README）。
# manifest.json 例外保留 —— 它只有 40 KB，记录了每篇论文的 arXiv ID、
# 标题、检索式与相关性得分，是"这批语料从哪来"的唯一凭证，值得进版本库。
ccus_docs/*.pdf
ccus_docs/*.part
ccus_docs/graph_ingest_state.json

# ============================================
# Unrelated local study material (kept on disk, not in repo)
# ============================================
俄语.pdf
rus_lesson1.txt
russian_docs/

# ============================================
# MCP client config (machine-specific absolute paths)
# ============================================
# .cursor/mcp.json 里写的是本机 venv 解释器与仓库绝对路径，
# 提交上去对别人就是错的；README 里给的是同一份配置的模板。
.cursor/mcp.json

# ============================================
# 自我进化的运行时数据
# ============================================
# experiences.jsonl 是每次评估追加一行的流水，reflections.json 是批次标记，
# semantic_memory.json 是从中提炼的先验 —— 都是本机运行产物，不是源码。
# 提交上去会让别人的系统一开始就带着"别人的经验"做判断。
history/

# ============================================
# Graphiti 评估探针的本地图库
# ============================================
# test_graphiti.py 每次运行都会重建这个 Kuzu 单文件库；
# 它是探针的产物，不是系统的数据。
graphiti_demo.kuzu

# ============================================
# 前端截图验证的临时产物
# ============================================
# e2e 截图脚本（puppeteer 驱动）落在仓库根目录，用来肉眼确认布局；
# 真正要进版本库的是 docs/ui-console.png 与 docs/ui-dashboard.png 这两张定稿。
ui_shot.png
ui_shot2.png
ui_report.png
ui_board.png

# ============================================
# 演示运行的自我进化数据
# ============================================
# 端到端演示时 EVOLVE_HOME 指向这里，避免把"演示经验"写进真实历史。
.demo-evolve/

# ============================================
# Docker 容器里的文件记忆
# ============================================
# compose 把 ./state 挂到 /app/state。挂目录而不是挂单个文件，是因为
# file_memory.py 用 os.replace 做原子重写，而 os.replace 作用在 bind mount 的
# **文件**上会返回 EBUSY（挂载点不能被替换）—— 症状是历史压缩失败、历史悄悄
# 停止增长，不报错。
# 注意目录名不能叫 memory/：那是本仓库的 Python 包（memory_manager.py 等），
# 把它挂掉等于把代码挂掉。
state/

# RAGAS evaluation output is a runtime artifact (CI uploads it separately).
eval/ragas_report.json
# 逐题断点（--resume 用），同样是运行产物。
eval/*.partial.jsonl
