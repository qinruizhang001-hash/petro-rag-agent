# ─── Notion Integration ────────────────────────────
# 获取 token: https://www.notion.so/my-integrations
# 创建 integration → 复制 secret 开头的 token
NOTION_TOKEN=secret_your_token_here

# 获取 Page ID: 打开你的 Notion 页面，从浏览器地址栏复制 ID（去掉横线）
# 记得在 Notion 页面里 → ··· → Connections → 连接你的 integration
NOTION_PAGE_ID=your_page_id_here

# ─── Tavily (联网搜索) ─────────────────────────────
# 获取 API key: https://tavily.com → 注册 → 复制 API key
# 免费额度 1000次/月，足够个人使用
TAVILY_API_KEY=tvly_your_key_here

# ─── Personal ChromaDB (独立于 CCUS 知识库) ─────
PERSONAL_CHROMA_PATH=./personal_chroma_db
PERSONAL_CHROMA_COLLECTION=personal_memory

# ─── CCUS Knowledge Base ChromaDB ─────────────────
CCUS_CHROMA_PATH=D:\python-learn\chroma_petro
# 查询与写入用的集合。v3 = v2 的克隆 + 新增 PDF 切片（严格超集）
CCUS_COLLECTION=ccus_knowledge_v3
# 增量入库时的源集合（ingest_ccus_batch.py 会把它的向量整库搬进 v3）
CCUS_COLLECTION_V3=ccus_knowledge_v3

# ─── Embedding Model ──────────────────────────────
# 留空 = 用 ChromaDB 内置的 all-MiniLM-L6-v2（384 维，随 chromadb 分发、离线可用）。
#
# 不要在这里填 BAAI/bge-small-zh-v1.5：它是 512 维，而库里存的向量是 384 维，
# 查询会因维度不一致直接失败。真要换模型，必须**整库重建**（写入端与查询端
# 一起换），详见 utils/embeddings.py。
EMBEDDING_MODEL=

# ─── Ollama 本地模型（和 multi_agent_ccus.py 用同一套） ────
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# 本地调用超时与重试上限（秒 / 次）。OpenAI SDK 默认 600s×3 = 一次卡死的生成
# 能占住半小时，且不抛异常 —— 实测 Ollama 在 report_plan 阶段就这样静默卡死过。
# 180s 对最长的一次生成（~1k token 报告，25s）有 7 倍余量。
LOCAL_LLM_TIMEOUT=180
LOCAL_LLM_MAX_RETRIES=1

# ─── 图谱检索广度（直接决定 Rerank 耗时，cross-encoder 是线性成本）──
# 默认 40/20 会在 23 篇语料上展开成 120 个候选、rerank 76 秒，
# 足以把整条工作流顶到前端 120 秒超时。收到 25/12 后是 87 个候选 / 51 秒，
# 而 Top-1 分数与 Top-2 选择完全不变（实测 0.9679）。
LIGHTRAG_TOP_K=25
LIGHTRAG_CHUNK_TOP_K=12

# ─── 检索后保留几篇文献注入报告 ──────────────────
RAG_TOP_K=2
# Self-RAG 相关性最低分（0~1）；低于阈值时切换策略重检一次，再拒绝低相关证据。
SELF_RAG_MIN_SCORE=0.55
# Query rewrite / Self-RAG grader 固定走本地 Ollama，不受 ROUTE_* 云端覆盖。
OLLAMA_MODEL=qwen2.5

# ─── 多模型路由：云端大模型（核心报告生成） ───────────────
# 不填 CLOUD_API_KEY 也能跑：report 阶段会自动降级到本地 qwen2.5，
# 并在日志里明确标注降级原因（不会静默假装走了云端）。
#
# 方式 A：直连云厂商（推荐，链路最短）
# DeepSeek: https://platform.deepseek.com → API keys
CLOUD_API_KEY=
CLOUD_BASE_URL=https://api.deepseek.com/v1
CLOUD_MODEL=deepseek-chat

# 想换成别家（OpenAI / 硅基流动 / 通义）只需改这两行，接口是 OpenAI 兼容的：
# CLOUD_BASE_URL=https://api.openai.com/v1
# CLOUD_MODEL=gpt-4o-mini

# 方式 B：指向本地聚合网关（magpie / one-api / LiteLLM 等）
# 好处：一份 key 库、多账号故障转移、统一用量统计、跨厂商模型名统一。
# 注意两点：
#   1) 网关模型名通常是 provider/model 形式（如 deepseek/deepseek-chat），
#      具体名字用 `python check_gateway.py` 看 /v1/models 的输出。
#   2) 本地网关一般不校验 key（安全边界是"能否连到这个端口"），填任意值即可。
# CLOUD_BASE_URL=http://127.0.0.1:3425/v1
# CLOUD_API_KEY=magpie
# CLOUD_MODEL=deepseek/deepseek-chat

# ─── 按角色单独指定路由（可选，覆盖上面的默认值）──────────
# 格式：ROUTE_<STAGE>=local | cloud | cloud:模型名 | local:模型名
# 角色：EXTRACT / REPORT / EVALUATE / HISTORY / SUMMARY
# 走网关时特别有用 —— 可以让不同角色用不同厂商的模型：
# ROUTE_REPORT=cloud:deepseek/deepseek-chat
# ROUTE_EVALUATE=cloud:kimi/kimi-k2
# ROUTE_EXTRACT=local

# ─── 文件记忆（File-Based Memory）───────────────────────
# 留空则默认使用项目根目录下的 user_profile.md / project_history.md
USER_PROFILE_PATH=
PROJECT_HISTORY_PATH=

# 历史记忆压缩：超过阈值（**字符数**，不是字节）就调用本地模型
# 把旧记录提炼成 3 条核心经验并重写文件，避免文件无限膨胀。
HISTORY_COMPRESS_THRESHOLD=3000
# 压缩时原样保留的最近条目数（纵向对比需要参数级可比，不能被摘要）
HISTORY_KEEP_RECENT=2

# ─── 可观测性（Observability）──────────────────────────
# 运行链路已全部改为 logging，不再用 print。
# 日志格式：时间戳 | 级别 | 模块 | model=local:.../cloud:... | tokens=N | 正文
APP_LOG_FILE=app.log
# DEBUG / INFO / WARNING / ERROR（非法值退回 INFO）
LOG_LEVEL=INFO

# ─── API 鉴权（Bearer Token）────────────────────────────
# 非空时，/api/* 全部要求 `Authorization: Bearer <API_TOKEN>`；/health 不需要。
# 前端（app.py）从同一个变量读，所以两边必须一致 —— 不一致的表现是前端 401，
# 而不是"没权限"，报错信息里会提示先核对这个值。
#
# 留空 = 关闭鉴权（本地开发方便），后端启动日志会打一条警告。
# 对外暴露前请换成随机串：openssl rand -hex 24
#
# 注意：Docker 栈读的是 .env.docker，不是本文件 —— 本文件是宿主机直跑用的。
API_TOKEN=

# ─── API 监听地址（Docker 里必须是 0.0.0.0）────────────
# 本地默认 127.0.0.1，不主动暴露到局域网
API_HOST=127.0.0.1
API_PORT=8000

# ─── 前端连接的后端地址（Docker Compose 里是 http://api:8000）──
# API_BASE_URL=http://127.0.0.1:8000
