# ─── Notion Integration ────────────────────────────
# 获取 token: https://www.notion.so/my-integrations
# 创建 integration → 复制 secret 开头的 token
NOTION_TOKEN=secret_your_token_here

# 获取 Page ID: 打开你的 Notion 页面，从浏览器地址栏复制 ID（去掉横线）
# 记得在 Notion 页面里 → ··· → Connections → 连接你的 integration
NOTION_PAGE_ID=your_page_id_here

# ─── Tavily (联网搜索) ─────────────────────────────
# 获取 API key: https://tavily.com → 注册 → 复制 API key
# 免费额度 1000次/月，足够个人使用
TAVILY_API_KEY=tvly_your_key_here

# ─── Personal ChromaDB (独立于 CCUS 知识库) ─────
PERSONAL_CHROMA_PATH=./personal_chroma_db
PERSONAL_CHROMA_COLLECTION=personal_memory

# ─── CCUS Knowledge Base ChromaDB ─────────────────
CCUS_CHROMA_PATH=D:\python-learn\chroma_petro
CCUS_COLLECTION=ccus_knowledge_v2

# ─── Embedding Model ──────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ─── Ollama (和 multi_agent_ccus.py 用同一套) ────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5
