# ─── Notion Integration ────────────────────────────
# 获取 token: https://www.notion.so/my-integrations
# 创建 integration → 复制 secret 开头的 token
NOTION_TOKEN=secret_your_token_here

# 获取 Page ID: 打开你的 Notion 页面，从浏览器地址栏复制 ID（去掉横线）
# 记得在 Notion 页面里 → ··· → Connections → 连接你的 integration
NOTION_PAGE_ID=your_page_id_here

# ─── Tavily (联网搜索) ─────────────────────────────
# 获取 API key: https://tavily.com → 注册 → 复制 API key
# 免费额度 1000次/月，足够个人使用
TAVILY_API_KEY=tvly_your_key_here

# ─── Personal ChromaDB (独立于 CCUS 知识库) ─────
PERSONAL_CHROMA_PATH=./personal_chroma_db
PERSONAL_CHROMA_COLLECTION=personal_memory

# ─── CCUS Knowledge Base ChromaDB ─────────────────
CCUS_CHROMA_PATH=D:\python-learn\chroma_petro
CCUS_COLLECTION=ccus_knowledge_v2

# ─── Embedding Model ──────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ─── Ollama 本地模型（和 multi_agent_ccus.py 用同一套） ────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5

# ─── 多模型路由：云端大模型（核心报告生成） ───────────────
# 不填 CLOUD_API_KEY 也能跑：report 阶段会自动降级到本地 qwen2.5，
# 并在日志里明确标注降级原因（不会静默假装走了云端）。
#
# DeepSeek: https://platform.deepseek.com → API keys
CLOUD_API_KEY=
CLOUD_BASE_URL=https://api.deepseek.com/v1
CLOUD_MODEL=deepseek-chat

# 想换成别家（OpenAI / 硅基流动 / 通义）只需改这两行，接口是 OpenAI 兼容的：
# CLOUD_BASE_URL=https://api.openai.com/v1
# CLOUD_MODEL=gpt-4o-mini

# ─── 文件记忆（File-Based Memory）───────────────────────
# 留空则默认使用项目根目录下的 user_profile.md / project_history.md
USER_PROFILE_PATH=
PROJECT_HISTORY_PATH=

# 历史记忆压缩：超过阈值（**字符数**，不是字节）就调用本地模型
# 把旧记录提炼成 3 条核心经验并重写文件，避免文件无限膨胀。
HISTORY_COMPRESS_THRESHOLD=3000
# 压缩时原样保留的最近条目数（纵向对比需要参数级可比，不能被摘要）
HISTORY_KEEP_RECENT=2
