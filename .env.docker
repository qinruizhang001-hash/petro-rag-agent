# ─────────────────────────────────────────────────────────────
# Docker 栈的环境变量（由 docker-compose.yml 的 env_file 注入）
#
# 为什么单独一个文件而不是复用 .env：
#   宿主机上的 .env 写的是 http://127.0.0.1:3425/v1（本机 magpie 网关）、
#   CCUS_CHROMA_PATH=D:\python-learn\chroma_petro（Windows 绝对路径）。
#   这两类值一进容器就全错 —— 容器里的 127.0.0.1 是容器自己，D 盘路径不存在。
#   所以 Docker 用自己的一份，容器网络里的服务名才是主机名。
#
# 本文件不含任何密钥，可以安全提交。要接真云端，取消下面「可选」段的注释。
# ─────────────────────────────────────────────────────────────

# ─── 后端 → Ollama ────────────────────────────────────────
# 注意：OLLAMA_BASE_URL 和 CCUS_CHROMA_PATH **不在这里**。
# 那两个值属于"容器网络契约"，钉在 docker-compose.yml 的 environment: 里，
# 因为把服务名改成 localhost 会让整个栈失联，这类值不开放给顺手改。
LOCAL_API_KEY=ollama
# 本地模型名。这里不带 provider/ 前缀：raw Ollama 端点不认识 "ollama/qwen2.5"
# 这种网关命名（那是 magpie / one-api 的写法），会直接 404。
LOCAL_MODEL=qwen2.5

# ─── 向量库 ───────────────────────────────────────────────
# 路径同理，见 docker-compose.yml。这里只调集合名。
CCUS_COLLECTION=ccus_knowledge_v3

# ─── 检索广度 ─────────────────────────────────────────────
# cross-encoder 的成本对候选数是线性的，这两个值直接决定地质分支的耗时。
# 25/12 是实测值：再放宽到 40/20 会把 rerank 推到 76 s，而 Top-2 选择不变。
LIGHTRAG_TOP_K=25
LIGHTRAG_CHUNK_TOP_K=12
RAG_TOP_K=2

# ─── 文件记忆 ─────────────────────────────────────────────
# 路径由 docker-compose.yml 的 environment: 指定（/app/memory/...），
# 因为那里挂的是目录而不是单个文件 —— 原因见 compose 里 volumes 的注释。
# 这里只调压缩策略。
HISTORY_COMPRESS_THRESHOLD=3000
HISTORY_KEEP_RECENT=2

# ─── 可选：接真云端大模型 ─────────────────────────────────
# 不配也能跑：DEFAULT_ROUTING 里 report / geology / wellbore 默认走 cloud，
# 但没有 CLOUD_API_KEY 时会**带原因降级**到本地，并在 model_routing 里如实记录
# （不会静默假装走了云端）。
#
# 取消注释并填入真 key，报告质量会明显上一档；改完 docker compose up -d 重建容器。
# 注意：配了 key 之后要同步把 CLOUD_MODEL 换成该厂商的模型名，
# 别再留 qwen2.5（那是本地模型名，发给云端端点必然 404）。
# CLOUD_BASE_URL=https://api.deepseek.com/v1
# CLOUD_API_KEY=sk-PUT_YOUR_KEY_HERE
# CLOUD_MODEL=deepseek-chat
# ROUTE_REPORT=cloud:deepseek/deepseek-chat

# ─── 可选：自我进化写图谱 ─────────────────────────────────
# 默认开启（每 20 次评估写一次先验进 LightRAG，单次最长阻塞 120 s）。
# 演示环境嫌慢可以设 0：经验仍然落盘 history/experiences.jsonl，
# 只是不再回写图谱。
# EVOLVE_WRITE_GRAPH=0
